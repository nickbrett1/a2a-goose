# ENV_FILE for the Mac Studio node agent.
# Install: cp to ~/.config/a2a-goose/env, fill in, chmod 0600.
# Sourced by scripts/fetch-launch.sh (set -a) immediately before the exec.

# --- identity -----------------------------------------------------------------
# This is what LiteLLM will record as metadata.user_agent on every spend-log row
# for this host. It is the whole point of this file having an identity at all.
# Keep the shape `a2a-goose/<host>`: it is what a spend query filters on.
#
# `Name: value` lines, NOT JSON - a JSON value here makes goose exit `Error
# invalid HTTP header name` and every turn fail with `-32603 … "Provider not
# set"`, and the `name=value` spelling silently drops the header. Measured on the
# NAS in S12 (2026-09-17); the table is in deploy/env/README.md.
export LITELLM_CUSTOM_HEADERS='User-Agent: a2a-goose/mac-studio'

# --- the agent's own surface --------------------------------------------------
# Bind loopback: the only thing that should reach this port is whatever fronts
# it, and on this host that is the LiteLLM container dialling `card.url`.
export A2A_GOOSE_BIND="127.0.0.1:10001"

# Must NOT be loopback. It is the URL registered with LiteLLM and dialled from
# inside the LiteLLM container, where 127.0.0.1 is the container itself. See S9.
export A2A_GOOSE_PUBLIC_URL="http://mac-studio.tail86fd19.ts.net:10001"

# Bearer token clients must present. Real value belongs in the host's secret
# store, not in this file; this is a placeholder and the file is mode 0600.
export A2A_GOOSE_BEARER_TOKEN="REPLACE_ME"

# --- goose --------------------------------------------------------------------
# The agent never installs goose (hard constraint #8) - it verifies it. Set this
# only if goose is not on the launcher's PATH.
export GOOSE_BIN="goose"
# Minimum enforced by scripts/check-goose.sh and src/goose.rs.
# export MIN_GOOSE_VERSION="1.50.0"

# goose's ACP credential, and so the one secret the *child* needs. The agent
# starts `goose serve` itself (goose.acp.serve: own), reads the variable its
# config names (goose.acp.secretEnv) and hands the value to the child as goose's
# own GOOSE_SERVER__SECRET_KEY - goose accepts no other name for it. Without a
# key goose will not start at all unless the config sets
# goose.acp.unauthenticated, which is a deliberate act rather than a default.
export GOOSE_SERVER__SECRET_KEY="REPLACE_ME"

# --- registry / attribution ---------------------------------------------------
export LITELLM_BASE_URL="http://nas:4000"
export LITELLM_MASTER_KEY="REPLACE_ME"

# goose's provider credential, if this host's agent-started goose has none of its
# own. The agent starts `goose serve` itself and that child inherits this file's
# environment and nothing else; on the NAS the key the human's interactive goose
# gets from `doppler run` never reached it, and turns failed with `(-32000)
# Authentication required` until this line existed. If this host's goose already
# holds its provider key (keyring, its own config), this is unnecessary.
# export LITELLM_API_KEY="REPLACE_ME"

# Optional - attribution route 2, a per-agent virtual key with NO budget
# attached (spikes/S2.md, addendum). Uncomment only if the User-Agent route
# above turns out not to survive goose's provider call.
# export LITELLM_AGENT_KEY="REPLACE_ME"
