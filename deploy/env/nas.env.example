# ENV_FILE for the NAS node agent.
# Install: cp to $HOME/.config/a2a-goose/env, fill in, chmod 0600.
# DSM 7 has no launchd - this file is sourced by deploy/dsm/a2a-goose-boot.sh on
# its way to scripts/fetch-launch.sh. Run as the user that owns goose, not root.

# --- identity -----------------------------------------------------------------
# This is what LiteLLM will record as metadata.user_agent on every spend-log row
# for this host. It is the whole point of this file having an identity at all.
# Keep the shape `a2a-goose/<host>`: it is what a spend query filters on.
#
# `Name: value` lines, NOT JSON. Measured on this host (S12, 2026-09-17):
# `{"User-Agent":"a2a-goose/nas"}` makes goose exit `Error invalid HTTP header
# name`, and every turn then fails with `-32603 … "Provider not set"`. The
# `name=value` spelling is accepted and silently drops the header. See
# deploy/env/README.md for the table.
export LITELLM_CUSTOM_HEADERS='User-Agent: a2a-goose/nas'

# --- the agent's own surface --------------------------------------------------
# Bind the address `publicUrl` names — **not** loopback. The dialer for
# `card.url` is the LiteLLM container, in its own network namespace: a
# loopback-bound agent registers an address nothing answers, and every call fails
# with a connection error while `/healthz` on the box still says 200. Measured on
# this host, 2026-09-17 (spikes/S15.md §6): the container *can* reach
# `100.82.223.13:10001` — it could not reach `127.0.0.1:10001`.
#
# Loopback is only right when something *fronts* the port, in which case
# `publicUrl` has to name that front. The agent warns at startup when the two
# disagree in that direction (`Config::warnings`).
export A2A_GOOSE_BIND="100.82.223.13:10001"

# Must NOT be loopback. It is the URL registered with LiteLLM and dialled from
# inside the LiteLLM container, where 127.0.0.1 is the container itself. See S9:
# that container has no DNS for the tailnet (`TS_ACCEPT_DNS=false`, gaierror -2),
# so this is the NAS's tailnet IP *literal*, not its tailnet name.
export A2A_GOOSE_PUBLIC_URL="http://100.82.223.13:10001"

# Bearer token clients must present. Real value belongs in the host's secret
# store, not in this file; this is a placeholder and the file is mode 0600.
export A2A_GOOSE_BEARER_TOKEN="REPLACE_ME"

# --- the roost hub (mission control) ------------------------------------------
# The credential the `hub:` block in config.yaml names (its credentialEnv). An
# agent appears in the roost fleet only by dialling the hub with this token as
# `Authorization: Bearer ...` on the WebSocket handshake - the hub is the entire
# auth boundary (there is no browser login). It is a SECRET: the real value
# lives in Doppler, project "goose", config "prd", key A2A_GOOSE_HUB_TOKEN. The
# placeholder below is not a value; fill it from Doppler before the restart.
#
# Why the whole fleet gets told: mac-studio (2026-09-25) ran for over a week
# registering with LiteLLM on every start and never appearing in mission
# control, because this key was absent from its env and its config.yaml had no
# hub block. deploy/ensure-hub.sh adds both when they are missing.
export A2A_GOOSE_HUB_TOKEN="REPLACE_ME"

# --- goose --------------------------------------------------------------------
# The agent never installs goose (hard constraint #8) - it verifies it. Absolute,
# not `goose`: the wrapper is started by DSM's Task Scheduler, which hands it
# *root's* environment (measured, DSM 7.4.1 - HOME=/root, USER=root, USER's PATH),
# so anything resolved against PATH or $HOME is root's, not this host user's. See
# spikes/S8.md.
export GOOSE_BIN="/usr/local/sbin/goose"
# Minimum enforced by scripts/check-goose.sh and src/goose.rs.
# export MIN_GOOSE_VERSION="1.50.0"

# goose's ACP credential, and so the one secret the *child* needs. The agent
# starts `goose serve` itself (goose.acp.serve: own), reads the variable its
# config names (goose.acp.secretEnv) and hands the value to the child as goose's
# own GOOSE_SERVER__SECRET_KEY - goose accepts no other name for it. Without a
# key goose will not start at all unless the config sets
# goose.acp.unauthenticated, which is a deliberate act rather than a default.
export GOOSE_SERVER__SECRET_KEY="REPLACE_ME"

# --- registry / attribution ---------------------------------------------------
# Loopback, not `http://nas:4000`: the proxy runs in a container on this same box,
# and `nas` is a name only *glibc* can resolve here. It is in no DNS zone
# (192.168.1.1: NXDOMAIN for `nas` and `nas.lan`); the only thing that resolves it
# is DSM's own /etc/hosts line, spelled `NAS`, and the musl-static payload matches
# /etc/hosts names exactly where glibc matches them case-insensitively. Measured:
# a lowercase hosts entry resolves for the payload, an uppercase one does not.
# spikes/S12.md has the isolation; registration failed on the name and succeeded
# on this address, on the first attempt.
export LITELLM_BASE_URL="http://127.0.0.1:4000"
export LITELLM_MASTER_KEY="REPLACE_ME"

# goose's *provider* credential, which is a different thing from the registry
# master key above and is required on this host. The agent starts `goose serve`
# itself and that child inherits this file's environment and nothing else; the
# goose in this box's own config runs the litellm provider, and the key the
# human's interactive goose gets from `doppler run` never reaches it. Without
# this line every turn fails *after* the version gate and the ACP handshake, with
# `goose refused the request (-32000): Authentication required` (measured,
# v0.1.25, 2026-09-17). Master key for now; a per-agent virtual key with no
# budget is the better answer (spikes/S2.md, route 2).
export LITELLM_API_KEY="REPLACE_ME"

# Optional - attribution route 2, a per-agent virtual key with NO budget
# attached (spikes/S2.md, addendum). Uncomment only if the User-Agent route
# above turns out not to survive goose's provider call.
# export LITELLM_AGENT_KEY="REPLACE_ME"
